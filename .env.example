# Optional. Value of the `sessionid` cookie of a logged-in Instagram session (DevTools > Application > Cookies).
# If Instagram rejects it, the scraper opens a window so you can log in by hand once.
INSTAGRAM_SESSIONID=

# Required for the personality analysis. Create a key in Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Model name; leave empty for the default. Run `python analyzer.py --list-models` to see
# which models your key can use.
GEMINI_MODEL=

# Copy this file to .env and never commit the real values.
